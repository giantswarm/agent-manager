{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "description": "Affinity.",
            "additionalProperties": true
        },
        "agentChart": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ociUrl": {
                    "type": "string",
                    "description": "OCI URL of the `agent` chart every agent renders from. Written into the shared per-namespace OCIRepository, and read at run time for the chart's values.schema.json that validates every create/update before it is applied (the pod needs egress to this registry; the embedded copy of the schema is the offline fallback)."
                },
                "refresh": {
                    "type": "string",
                    "description": "How often the registry is re-read for the latest version and schema."
                },
                "semver": {
                    "type": "string",
                    "description": "Semver range the OCIRepository tracks. `x.x.x` follows every published release, the platform convention for agents."
                }
            }
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "extraArgs": {
            "type": "array",
            "description": "Extra container arguments."
        },
        "extraEnv": {
            "type": "array",
            "description": "Extra environment variables.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "valueFrom": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "flux": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "helmReleaseApiVersion": {
                    "type": "string",
                    "description": "helm.toolkit.fluxcd.io API version composed into HelmReleases; `auto` discovers it."
                },
                "helmReleaseInterval": {
                    "type": "string",
                    "description": "HelmRelease.spec.interval of every composed agent."
                },
                "helmReleaseServiceAccount": {
                    "type": "string",
                    "description": "HelmRelease.spec.serviceAccountName, required by a Flux multi-tenancy admission policy in tenant namespaces; empty omits it."
                },
                "ociRepositoryApiVersion": {
                    "type": "string",
                    "description": "source.toolkit.fluxcd.io API version composed into OCIRepositories; `auto` discovers it."
                },
                "ociRepositoryInterval": {
                    "type": "string",
                    "description": "OCIRepository.spec.interval of the shared chart source."
                }
            }
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Override the fully qualified release name (the umbrella chart pins the Service name through this)."
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "additionalProperties": true
        },
        "httpRoute": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations on the HTTPRoute.",
                    "additionalProperties": true
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Expose the service through a Gateway API HTTPRoute."
                },
                "hostnames": {
                    "type": "array",
                    "description": "Hostnames matched by the route."
                },
                "labels": {
                    "type": "object",
                    "description": "Labels on the HTTPRoute.",
                    "additionalProperties": true
                },
                "parentRefs": {
                    "type": "array",
                    "description": "parentRefs of the HTTPRoute (required when enabled).",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "group": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "namespace": {
                                "type": "string"
                            },
                            "port": {
                                "type": "integer"
                            },
                            "sectionName": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "description": "Image pull policy."
                },
                "registry": {
                    "type": "string",
                    "description": "Image registry."
                },
                "repository": {
                    "type": "string",
                    "description": "Image repository."
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag. Defaults to the chart appVersion."
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Image pull secrets."
        },
        "kagent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "additionalNamespaces": {
                    "type": "array",
                    "description": "Additional namespaces agents may live in (multi-tenant installs). Each gets the same Role; requests naming any other namespace are refused."
                },
                "apiVersion": {
                    "type": "string",
                    "description": "kagent.dev API version for Agents and ModelConfigs; `auto` discovers the server's preferred version."
                },
                "namespace": {
                    "type": "string",
                    "description": "Namespace agents are created in and listed from by default — the namespace kagent watches and the platform admin provisions ModelConfigs into. The Role for HelmReleases, OCIRepositories, Agents, ModelConfigs, Deployments, pods and events is created here."
                }
            }
        },
        "logging": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "verbose": {
                    "type": "boolean",
                    "description": "Enable debug logging."
                }
            }
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Serve the MCP streamable-HTTP endpoint alongside the REST API."
                },
                "path": {
                    "type": "string",
                    "description": "MCP endpoint path."
                }
            }
        },
        "muster": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "mcpServer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "description": {
                            "type": "string",
                            "description": "Human-readable description shown by muster."
                        },
                        "auth": {
                            "type": "object",
                            "description": "How muster authenticates to this server; rendered only with `oauth.enabled`. `forwardToken` makes muster forward the session's IdP id_token byte-identical (the SSO path this chart trusts through `oauth.trustedAudiences`). `requiredAudiences` are extra audiences that token must carry — the Dex cross-client audience the kube-apiserver trusts (`dex-k8s-authenticator` on Giant Swarm clusters; agentlab's is `kubernetes`) so `oauth.downstream` works; muster requests them at login, so users re-login after a change. They are trusted as bearer audiences too (see `oauth.trustedAudiences`). A Google IdP has no cross-client audiences: leave the list empty.",
                            "additionalProperties": false,
                            "properties": {
                                "forwardToken": {
                                    "type": "boolean"
                                },
                                "requiredAudiences": {
                                    "type": "array"
                                }
                            }
                        },
                        "autoStart": {
                            "type": "boolean",
                            "description": "Start the server connection when muster initializes."
                        },
                        "enabled": {
                            "type": "boolean",
                            "description": "Register this server with muster by rendering an `mcpservers.muster.giantswarm.io` CR in the release namespace. Tools then appear as `x_<name>_<tool>`."
                        },
                        "labels": {
                            "type": "object",
                            "description": "Extra labels on the MCPServer CR.",
                            "additionalProperties": true
                        },
                        "name": {
                            "type": "string",
                            "description": "MCPServer CR name (drives the tool prefix)."
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "Override the chart name."
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowInternet": {
                    "type": "boolean",
                    "description": "Allow egress on 443 to every destination: the chart registry (schema and version) and GitHub (skills). Vanilla NetworkPolicy cannot select by name; narrow with egressCIDRs instead when the addresses are known."
                },
                "allowKubeAPI": {
                    "type": "boolean",
                    "description": "Allow egress to the Kubernetes API server."
                },
                "egressCIDRs": {
                    "type": "array",
                    "description": "Extra egress CIDRs."
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Create a Kubernetes NetworkPolicy for the pod (off when an umbrella chart renders the policies)."
                },
                "ingressNamespaces": {
                    "type": "array",
                    "description": "Namespaces allowed to reach the API (label kubernetes.io/metadata.name). Empty allows ingress from the release namespace only."
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector.",
            "additionalProperties": true
        },
        "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPublicClientRegistration": {
                    "type": "boolean",
                    "description": "Accept unauthenticated dynamic client registration (labs only)."
                },
                "baseURL": {
                    "type": "string",
                    "description": "Public base URL of this server: the issuer of its own OAuth metadata (https, or http on loopback). Empty derives `https://<fullname>.<global.domain>` when `global.domain` is set."
                },
                "dex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateURLs": {
                            "type": "boolean",
                            "description": "Let the issuer resolve to a private or loopback address (an in-cluster Dex)."
                        },
                        "caSecret": {
                            "type": "object",
                            "description": "Secret with the CA of a Dex that serves a private certificate; `global.identity.ca.secretName` / `global.identity.ca.key`.",
                            "additionalProperties": false,
                            "properties": {
                                "key": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            }
                        },
                        "clientID": {
                            "type": "string",
                            "description": "Dex OAuth client ID. Empty falls back to `global.identity.clientId`."
                        },
                        "clientSecret": {
                            "type": "string",
                            "description": "Dex OAuth client secret (prefer `oauth.existingSecret`)."
                        },
                        "issuerURL": {
                            "type": "string",
                            "description": "Dex issuer URL. Empty falls back to `global.identity.issuerUrl`."
                        }
                    }
                },
                "downstream": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Call the Kubernetes API as the caller: everything a request does (HelmReleases and OCIRepositories, the Agents, ModelConfigs, Deployments, pods and events it reads) presents the caller's IdP token, so the caller's RBAC governs — the apiserver must trust the IdP and the token's audience (a Dex install lists that audience in `muster.mcpServer.auth.requiredAudiences`; a Google install's client id permissions: the chart renders none of its Roles (`rbac.create` is moot) and the token stays mounted only for the in-cluster API address and CA plus API discovery at startup, which every authenticated principal may read. agent-manager has no background work, so nothing is lost: a request without a token is refused with 401 instead of running as the ServiceAccount."
                        }
                    }
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Make agent-manager an OAuth 2.1 resource server (mcp-oauth): the MCP endpoint and the REST API require a bearer token the platform identity provider issued, and every call carries the caller's identity (logged on every write, returned as `requestedBy`). On the Agent Platform muster forwards the session's IdP id_token to this server (MCPServer `auth.forwardToken`, rendered below) and the portal sends the signed-in user's id_token through the gateway; both are validated against the IdP's JWKS when their audience is in `trustedAudiences`. Off: anonymous, acting as the ServiceAccount — only for a server nothing but a trusted proxy can reach."
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with the provider credentials: `dex-client-secret` (dex) or `google-client-secret` (+ optional `google-client-id`) (google). Empty falls back to `global.identity.existingSecret`, whose `dex-client-secret` is the platform client's; without that, the chart renders a Secret from the values above."
                },
                "google": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "clientID": {
                            "type": "string",
                            "description": "Google OAuth client ID (not secret; may also come from the Secret key `google-client-id` when empty)."
                        },
                        "clientSecret": {
                            "type": "string",
                            "description": "Google OAuth client secret (prefer `oauth.existingSecret`)."
                        }
                    }
                },
                "provider": {
                    "type": "string",
                    "description": "Identity provider: `dex` or `google`."
                },
                "sso": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateIPs": {
                            "type": "boolean",
                            "description": "Let the IdP's JWKS endpoint resolve to a private address when validating forwarded tokens (an in-cluster Dex)."
                        }
                    }
                },
                "trustedAudiences": {
                    "type": "array",
                    "description": "OAuth client IDs whose IdP id_tokens are accepted as bearer tokens (SSO token forwarding). Empty falls back to `[global.identity.clientId]`, the platform client muster's own sessions log in with. The audiences in `muster.mcpServer.auth.requiredAudiences` are trusted in addition, always: every token muster forwards carries them by construction and they are what the kube-apiserver trusts, so a session that signed in through another client — the portal's — is accepted too. Set this only for audiences beyond those two."
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations on the pod.",
            "additionalProperties": true
        },
        "podLabels": {
            "type": "object",
            "description": "Labels on the pod.",
            "additionalProperties": true
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod security context.",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "rbac": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Create the Role/RoleBinding in `kagent.namespace` (and every `kagent.additionalNamespaces` entry): HelmReleases and OCIRepositories read/write; Agents, ModelConfigs, Deployments, pods and events read — the ServiceAccount's own permissions. Ignored with `oauth.downstream.enabled`: the ServiceAccount then gets no RBAC at all, the caller's RBAC governs."
                }
            }
        },
        "replicaCount": {
            "type": "integer",
            "description": "Number of replicas. The service is stateless (every read goes to the API server); more than one is fine."
        },
        "resources": {
            "type": "object",
            "description": "Container resources.",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "description": "Container security context.",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Service type."
                },
                "port": {
                    "type": "integer",
                    "description": "Service port (container listens on 8080)."
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations on the ServiceAccount.",
                    "additionalProperties": true
                },
                "create": {
                    "type": "boolean",
                    "description": "Create a ServiceAccount."
                },
                "name": {
                    "type": "string",
                    "description": "ServiceAccount name (generated when empty)."
                }
            }
        },
        "skills": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cacheTTL": {
                    "type": "string",
                    "description": "How long a repository's discovered skills are reused."
                },
                "github": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "apiUrl": {
                            "type": "string",
                            "description": "GitHub API base URL."
                        },
                        "tokenSecret": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "description": "Key of the token in that Secret."
                                },
                                "name": {
                                    "type": "string",
                                    "description": "Existing Secret in the release namespace with a GitHub token (private skill repositories, higher rate limit). Empty: anonymous."
                                }
                            }
                        }
                    }
                },
                "repositories": {
                    "type": "array",
                    "description": "GitHub repositories whose SKILL.md files list_skills offers (the same list the portal's create flow reads). Empty turns the skills capability off.",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "effect": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "operator": {
                        "type": "string"
                    },
                    "tolerationSeconds": {
                        "type": "integer"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
